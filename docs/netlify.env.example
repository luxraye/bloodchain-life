# Copy into Netlify → Site configuration → Environment variables
# Replace bc-api-lu8j with your Render bc-api hostname (Dashboard → bc-api → URL)

# ── API (all apps that use bloodchain-core REST) ─────────────────────────────
VITE_API_URL=https://bc-api-lu8j.onrender.com/api/v1

# ── Supabase (all apps with auth) ────────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# ── Cross-app links (demo-hub, high-command) ─────────────────────────────────
VITE_HIGH_COMMAND_URL=https://command.bloodchain.life
VITE_MARS_LAB_URL=https://mars.bloodchain.life
VITE_VOYAGER_URL=https://voyager.bloodchain.life
VITE_SCYTHER_URL=https://scyther.bloodchain.life
VITE_AZURE_URL=https://azure.bloodchain.life
VITE_TRANSFUSE_URL=https://transfuse.bloodchain.life
VITE_HELIX_URL=https://helix.bloodchain.life
VITE_CHRONICLE_URL=https://chronicle.bloodchain.life
VITE_SENTINEL_URL=https://sentinel.bloodchain.life

# ── Optional ─────────────────────────────────────────────────────────────────
# VITE_SUPERVISOR_PIN=          # mars-lab
# VITE_INSTANCES_API_URL=       # sentinel
# VITE_INSTANCES_API_KEY=
# VITE_INSTANCES_ADMIN_URL=
