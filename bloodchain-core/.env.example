# Bloodchain Core environment variables
# Copy to .env and set real values. Do not commit secrets.

# API
PORT=4000
NODE_ENV=development

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bloodchain_core?schema=public"

# Supabase
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"
# Optional for HS256 local tokens; leave empty for JWKS-only verification.
SUPABASE_JWT_SECRET=""
